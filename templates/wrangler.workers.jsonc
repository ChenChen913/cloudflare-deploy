{
  // Workers + 静态资源。复制到仓库根目录并改名为 wrangler.jsonc。
  // 纯静态站删除 main 和 binding 即可。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "替换成项目名",
  "compatibility_date": "2026-11-14",
  "main": "./src/index.ts",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
    // SPA 改成 "single-page-application"。
    // 需要 Worker 先于静态资源执行时，加：
    // "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
